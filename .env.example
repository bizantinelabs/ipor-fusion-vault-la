# RPC URLs. Populate only the chains you operate on.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Required for live transactions: scripts/execute_rebalance.py --execute and
# scripts/deploy_vault.py --execute. Never commit private keys or a populated .env file.
OPERATOR_PRIVATE_KEY=

# Owner/atomist address for a newly deployed vault (scripts/deploy_vault.py).
VAULT_OWNER_ADDRESS=
